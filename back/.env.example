ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://caleb:caleb@localhost:5434/caleb_dev
# Solo en QA/produccion: endpoint directo de Neon, sin pooler. Vacio usa DATABASE_URL.
MIGRATION_DATABASE_URL=
DB_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]
TEST_DATABASE_URL=postgresql+psycopg://caleb:caleb@localhost:5434/caleb_test
# Genera uno distinto por entorno, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Cloudflare R2: donde se guardan los archivos (logo de la empresa). Un bucket y
# un token por entorno: caleb-dev (local y tests), caleb-qa, caleb-prod.
# El endpoint sale del panel de R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Llave y secreto del token de API de R2, con lectura y escritura solo sobre este bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=caleb-dev
